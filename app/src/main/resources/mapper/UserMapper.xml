<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kyobo.server.mapper.UserMapper">

  <!-- 학습용 base: findByLoginId는 로그인 PR에서 추가되는 것으로 보이게 여기서는 제거 -->
  <insert id="insert" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
    INSERT INTO users (login_id, user_pw, name, age, phone_number, is_deleted)
    VALUES (#{loginId}, #{userPw}, #{name}, #{age}, #{phoneNumber}, FALSE)
  </insert>

</mapper>
