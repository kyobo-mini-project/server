<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kyobo.server.mapper.RoomMapper">

  <select id="findActiveByCinemaId" resultType="com.kyobo.server.entity.Room">
    SELECT room_id,
           cinema_id,
           room_name,
           floor,
           is_active
    FROM rooms
    WHERE cinema_id = #{cinemaId}
      AND is_active = TRUE
    ORDER BY room_id ASC
  </select>

</mapper>
