<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kyobo.server.mapper.GenreMapper">

    <select id="findAll"
            resultType="com.kyobo.server.entity.Genre">
        SELECT genre_id, genre_name
        FROM genres
        ORDER BY genre_id
    </select>

</mapper>