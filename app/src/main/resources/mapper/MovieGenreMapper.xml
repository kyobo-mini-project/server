<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kyobo.server.mapper.MovieGenreMapper">

    <insert id="insert">
        INSERT INTO movie_genres (
        movie_id,
        genre_id
        )
        VALUES (
        #{movieId},
        #{genreId}
        )
    </insert>

</mapper>